# Translation: any OpenAI-compatible chat completions API.
# LLM_BASE_URL is the API root; the app appends /chat/completions.
# Default: Gemma on Google AI Studio's free tier (key from https://aistudio.google.com/apikey).
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemma-4-31b-it
# Gemma on AI Studio rejects system prompts; keep this false for it.
LLM_SYSTEM_PROMPT=false
